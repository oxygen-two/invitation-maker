# This is a LOCAL DEVELOPMENT template. `npm start`, `npm run admin`,
# `npm run dev`, and `npm run dev:admin` are all local-developer commands —
# none of them run in production. Production configuration lives ONLY in
# Vercel's environment variables (see api/*.js and scripts/build-public.cjs,
# which is what actually deploys); it must never be committed or kept here.
#
# Copy this file to .env for `npm start`/`npm run admin`. `.env.dev` is a
# second, equally local set of values for `npm run dev`/`npm run dev:admin` —
# handy for pointing at a second local database or a different local config
# without touching `.env`. Both files should point at your own machine.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=invitation_maker
PUBLISH_ALLOWED_ORIGIN=
# Set PUBLISH_ALLOWED_ORIGIN to the deployed HTTPS origin in production.
# API errors use {"error":{"code":"...","message":"..."}}.
PUBLISH_MAX_BYTES=2000000
# Sliding expiry. A publication expires PUBLISH_IDLE_WINDOW_DAYS after its last
# public read, and never lives longer than PUBLISH_MAX_LIFETIME_DAYS after it was
# published. Set PUBLISH_MAX_LIFETIME_DAYS=0 to disable expiry entirely, or
# PUBLISH_IDLE_WINDOW_DAYS=0 for a plain fixed lifetime with no sliding.
# PUBLISH_TTL_DAYS was replaced by these two settings and is no longer read.
PUBLISH_IDLE_WINDOW_DAYS=7
PUBLISH_MAX_LIFETIME_DAYS=30
# A public read only writes a new expiry when it moves by more than this many
# hours, so a popular invitation costs at most a few writes per day.
PUBLISH_EXPIRY_REFRESH_HOURS=6
PUBLISH_RATE_LIMIT_PER_HOUR=10
PUBLISH_TOTAL_DAILY_LIMIT=100
PUBLISH_LIFETIME_LIMIT=1000
PUBLISH_TRUST_PROXY=false
HOST=127.0.0.1
PORT=4173
ADMIN_PASSWORD=
ADMIN_HOST=0.0.0.0
ADMIN_PORT=4174
ADMIN_SESSION_TTL_MS=28800000
ADMIN_PAGE_SIZE=20
PUBLIC_BASE_URL=
# Enable ONLY when the admin service runs behind a trusted HTTPS-terminating proxy
# (e.g. Cloudtype). It makes the session cookie honor x-forwarded-proto, which is
# otherwise attacker-controllable and never trusted by default.
ADMIN_TRUST_PROXY=false
